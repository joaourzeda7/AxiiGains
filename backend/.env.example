# Chave do Gemini: crie grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui
# Modelo do Gemini (o alias "latest" sempre aponta para o Flash mais novo)
GEMINI_MODEL=gemini-flash-latest

# Usada para assinar os tokens de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_string_aleatoria_longa

# Pasta onde fica o arquivo do banco SQLite.
# No deploy, aponte para o volume persistente (ex.: /data)
DATA_DIR=.

# Opcional: se definido, o cadastro exige este código de convite.
# Recomendado no deploy, para estranhos não criarem conta (nem gastarem sua cota do Gemini).
REGISTRATION_CODE=
